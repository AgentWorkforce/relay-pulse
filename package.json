{
  "name": "@agent-relay/pulse",
  "version": "1.1.0",
  "description": "Visualize agent-to-agent communication in real-time with animated particle flows",
  "keywords": [
    "agent",
    "relay",
    "visualization",
    "animation",
    "particle",
    "svelte",
    "ai-agents",
    "message-flow"
  ],
  "author": "Agent Workforce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentWorkforce/relay-pulse.git"
  },
  "homepage": "https://github.com/AgentWorkforce/relay-pulse#readme",
  "bugs": {
    "url": "https://github.com/AgentWorkforce/relay-pulse/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "default": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:vite": "vite dev",
    "build": "vite build && npm run package && npm run build:element",
    "build:element": "vite build --config vite.config.element.js",
    "package": "svelte-kit sync && svelte-package && publint",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepublishOnly": "npm run package"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "publint": "^0.2.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
